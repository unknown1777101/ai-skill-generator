{
  "name": "ai-skill-creator",
  "version": "1.0.0",
  "description": "Antigravity Skill Creator & Plugin Validator Package",
  "main": "scripts/validate_plugin.js",
  "bin": {
    "skill-creator": "scripts/skill-creator.js",
    "skill-creator-update": "scripts/skill-creator-update.js",
    "skill-creator-uninstall": "scripts/skill-creator-uninstall.js",
    "skill-creator-validate": "scripts/skill-creator-validate.js",
    "validate-skill": "scripts/validate_skill.js",
    "validate-plugin": "scripts/validate_plugin.js",
    "skill-validate": "scripts/validate_skill.js",
    "plugin-validate": "scripts/validate_plugin.js",
    "install-skill": "postinstall.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'), p=require('path').join(__dirname, 'postinstall.js'); if (fs.existsSync(p)) { try { require(p); } catch(e){} }\"",
    "validate": "node scripts/validate_plugin.js .agents/skills/skill-creator",
    "validate:sample": "node scripts/validate_plugin.js plugins/sample-react-plugin"
  },
  "keywords": [
    "antigravity",
    "skills",
    "plugin",
    "ai-agent",
    "skill-creator"
  ],
  "author": "Anzar",
  "license": "MIT"
}
